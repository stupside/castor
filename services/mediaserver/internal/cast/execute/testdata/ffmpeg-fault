#!/bin/sh
# ffmpeg whose h264_* encoders are libx264 with an injected fault.
signal= after=3 paced=
case " $* " in *" h264_paced "*) paced=1 ;; esac
for a do
	shift
	case $a in
	h264_crash) signal=SEGV a=libx264 ;;
	h264_hang) signal=STOP a=libx264 ;;
	h264_mute) signal=STOP after=0 a=libx264 ;;
	h264_paced) a=libx264 ;;
	-i) [ -n "$paced" ] && set -- "$@" -readrate 1 ;;
	esac
	set -- "$@" "$a"
done
if [ -n "$signal" ]; then
	(sleep "$after"; kill -"$signal" $$) </dev/null >/dev/null 2>&1 3>&- 4>&- 5>&- 6>&- 7>&- 8>&- 9>&- &
fi
exec ffmpeg "$@"
